@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
<div class="ml-page">
    <nav class="ml-sidebar">
        <NavLink href="" class="ml-brand-link" Match="NavLinkMatch.Prefix">
            <div class="ml-sidebar-brand">
                <img class="ml-brand-icon" src="icon-192.png" />
                <span class="ml-brand-name">StockFlow</span>
            </div>
        </NavLink>


        <AuthorizeView Context="auth">
            <Authorized>
                <div class="ml-navbar-links">
                    <h5>Main menu</h5>
                    <NavLink href="inventory" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>Inventory</span>
                    </NavLink>
                    <NavLink href="productbrands" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-building"></i>
                        <span>Brands</span>
                    </NavLink>
                    <NavLink href="sales" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-tags-fill"></i>
                        <span>Sales</span>
                    </NavLink>
                    <NavLink href="shelves" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-bookshelf"></i>
                        <span>Shelves</span>
                    </NavLink>

                    <AuthorizeView Roles="@Permissions.CashRegisterLogs">
                        <h5>Logs</h5>
                        <NavLink href="cashregisterlogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-currency-exchange"></i>
                            <span>Cash register logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.StockLogs">
                        <NavLink href="stocklogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-receipt"></i>
                            <span>Stock logs</span>
                        </NavLink>
                        <NavLink href="producthistory" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-clock-history"></i>
                            <span>Product history</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.CustomerLogs">
                        <NavLink href="customerlogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Customer Logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.EmployeeLogs">
                        <NavLink href="employeelogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-vcard"></i>
                            <span>Employee Logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.ViewEmployees">
                        <h5>Management</h5>
                        <NavLink href="employees" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-vcard"></i>
                            <span>Employees</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.ViewCustomers">
                        <NavLink href="customers" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-fill"></i>
                            <span>Customers</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.ViewMovingSales">
                        <NavLink href="movingsales" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Moving sales</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Permissions.Statistics">
                        <NavLink href="statistics" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span>Statistics</span>
                        </NavLink>
                    </AuthorizeView>
                </div>

                <div class="ml-user" title="Logged in as @auth.User.Identity?.Name">
                    <i class="bi bi-person-circle"></i>
                    <div class="ml-user-text">
                        <span class="ml-user-name">@(auth.User.Identity?.Name ?? "Unknown")</span>
                        <span class="ml-user-role">@EmployeeId(auth.User) &middot; @RoleName(auth.User)</span>
                    </div>
                </div>

                <button class="ml-logout-btn" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>LogOut</span>
                </button>

                <NavLink href="" class="ml-version" Match="NavLinkMatch.All" title="Releases">
                    <i class="bi bi-tag"></i>
                    <span>StockFlow @AppVersion.Display(version)</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="ml-main-content">
        @Body
    </main>
</div>


@code {
    private readonly string version = AppVersion.Of(typeof(Program).Assembly);

    private static string EmployeeId(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Thumbprint)?.Value ?? "-";

    private static string RoleName(System.Security.Claims.ClaimsPrincipal user) =>
        System.Text.RegularExpressions.Regex.Replace(user.EmployeeRole().ToString(), "(?<=[a-z])(?=[A-Z])", " ");

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login");
    }
}