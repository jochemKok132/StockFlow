@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
<div class="ml-page">
    <nav class="ml-sidebar">
        <NavLink href="/" style="text-decoration: none;" Match="NavLinkMatch.Prefix">
            <div class="ml-sidebar-brand">
                <img class="ml-brand-icon" src="/icon-192.png" />
                <span class="ml-brand-name">StockFlow</span>
            </div>
        </NavLink>


        <AuthorizeView Context="auth">
            <Authorized>
                <div class="ml-navbar-links">
                    <h5>Main menu</h5>
                    <NavLink href="/inventory" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>Inventory</span>
                    </NavLink>
                    <NavLink href="/sales" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-tags-fill"></i>
                        <span>Sales</span>
                    </NavLink>
                    <NavLink href="/shelves" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-bookshelf"></i>
                        <span>Shelves</span>
                    </NavLink>

                    <AuthorizeView Roles="Cashier,ServiceDesk,ShiftLeader,Manager,Admin">
                        <h5>Logs</h5>
                        <NavLink href="/cashregisterlogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-currency-exchange"></i>
                            <span>Cash register logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="ServiceDesk,ShiftLeader,Manager,Admin">
                        <NavLink href="/stocklogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-receipt"></i>
                            <span>Stock logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="Manager,Admin">
                        <NavLink href="/customerlogs" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Customer Logs</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="ShiftLeader,Manager,Admin">
                        <h5>Management</h5>
                        <NavLink href="/employees" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-vcard"></i>
                            <span>Employees</span>
                        </NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="Manager,Admin">
                        <NavLink href="/customers" class="ml-nav-link" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-person-fill"></i>
                            <span>Customers</span>
                        </NavLink>
                    </AuthorizeView>
                </div>

                <button class="ml-logout-btn" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>LogOut</span>
                </button>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="ml-main-content">
        @Body
    </main>
</div>


@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}