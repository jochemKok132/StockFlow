@page "/Employees";
@attribute [Authorize]
@inject IEmployeeService employeeService

<div class="tasks-header">
    <div>
        <h2>Employee management</h2>
    </div>
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Employee name</label>
                <input type="text" @bind="pagination.EmployeeName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Employee Id</label>
                <input type="text" @bind="pagination.EmployeeId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 000012" />
            </div>
            <div class="filter-group">
                <label>Role</label>
                <select @bind="pagination.Role" @bind:after="ResetAndLoad">
                    <option value="">All</option>
                    @foreach (var value in Enum.GetValues<EmployeeRoleDto>())
                    {
                        <option value="@value">@value.ToString()</option>
                    }
                </select>
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(EmployeeOrderBy.EmployeeName)" class="sortable">
                    Full name @SortingArrow(EmployeeOrderBy.EmployeeName)
                </th>
                <th @onclick="() => OrderBy(EmployeeOrderBy.EmployeeId)" class="sortable">
                    Employee Id @SortingArrow(EmployeeOrderBy.EmployeeId)
                </th>
                <th @onclick="() => OrderBy(EmployeeOrderBy.Role)" class="sortable">
                    Role @SortingArrow(EmployeeOrderBy.Role)
                </th>
                <th @onclick="() => OrderBy(EmployeeOrderBy.CreatedAt)" class="sortable">
                    Created at @SortingArrow(EmployeeOrderBy.CreatedAt)
                </th>
                <th @onclick="() => OrderBy(EmployeeOrderBy.UpdatedAt)" class="sortable">
                    Updated at @SortingArrow(EmployeeOrderBy.UpdatedAt)
                </th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these employees. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (employees.Count == 0)
            {
                <tr><td class="empty-state">No employees fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var Employee in employees)
                {
                    <tr class="clickable-row">
                        <td><strong>@Employee.FullName</strong></td>
                        <td>@Employee.EmployeeId</td>
                        <td>@Employee.Role</td>
                        <td class="date-cell">@Employee.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                        <td class="date-cell">@Employee.UpdatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(employees.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@code {
    private List<EmployeeDto> employees = new List<EmployeeDto>();

    private bool loading = false;
    private bool detailsLoading = false;
    private string detailsError = "";
    private bool showDetails = false;
    private bool noAccess = false;
    private string error = "";
    private EmployeeDto? selectedEmployee; 

    private EmployeePaginationDto pagination = new EmployeePaginationDto
    {
        OrderBy = EmployeeOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        EmployeeName = null,
        EmployeeId = null,
        Role = null,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployee();
    }

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadEmployee();
    }
    private async Task OrderBy(EmployeeOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadEmployee();
    }

    private RenderFragment SortingArrow(EmployeeOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadEmployee();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadEmployee();
    }
    private async Task LoadEmployee()
    {
        loading = true;
        noAccess = false;
        error = "";

        (employees, error) = await employeeService.GetPaginatedEmployeesAsync(pagination);

        loading = false;
    }
}
