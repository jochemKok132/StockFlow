@page "/customers";
@attribute [Authorize(Roles = Permissions.ViewCustomers)]
@inject ICustomerService customerService

<div class="tasks-header">
    <div>
        <h2>Customer management</h2>
        <p>All registered customers.</p>
    </div>
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Customer ID</label>
                <input type="text" inputmode="numeric" maxlength="@IdentifierFormats.CustomerIdLength" @bind="pagination.CustomerId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 80000001" />
            </div>
            <div class="filter-group">
                <label>Customer name</label>
                <input type="text" maxlength="@FieldLimits.Name" @bind="pagination.CustomerName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Email</label>
                <input type="email" maxlength="@FieldLimits.Email" @bind="pagination.Email" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. john@mail.com" />
            </div>
            <div class="filter-group">
                <label>Postal code</label>
                <input type="text" maxlength="@FieldLimits.PostalCode" @bind="pagination.PostalCode" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 1234AB" />
            </div>
            <div class="filter-group">
                <label>Housenumber</label>
                <input type="text" maxlength="@FieldLimits.HouseNumber" @bind="pagination.HouseNumber" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 5" />
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(CustomerOrderBy.CustomerId)" class="sortable">
                    Customer ID @SortingArrow(CustomerOrderBy.CustomerId)
                </th>
                <th @onclick="() => OrderBy(CustomerOrderBy.FullName)" class="sortable">
                    Full name @SortingArrow(CustomerOrderBy.FullName)
                </th>
                <th>Email</th>
                <th>Postal code</th>
                <th>Housenumber</th>
                <th @onclick="() => OrderBy(CustomerOrderBy.SavedPoints)" class="sortable">
                    Saved points @SortingArrow(CustomerOrderBy.SavedPoints)
                </th>
                <th>Moving sale</th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these customers. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (customers.Count == 0)
            {
                <tr><td class="empty-state">No customers fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var customer in customers)
                {
                    <tr>
                        <td class="id-cell">@customer.CustomerId</td>
                        <td><strong>@customer.FullName</strong></td>
                        <td>@customer.Email</td>
                        <td>@customer.PostalCode</td>
                        <td>@customer.HouseNumber</td>
                        <td>@customer.SavedPoints</td>
                        <td>
                            @if (SalePricing.IsMovingSaleActive(customer.MovingSaleUntil, DateTime.Today))
                            {
                                <span class="status-badge status-ok">Until @customer.MovingSaleUntil!.Value.ToString("dd-MM-yyyy")</span>
                            }
                            else if (customer.MovingSaleStatus == MovingSaleStatusDto.Pending)
                            {
                                <span class="status-badge status-update">Waiting for approval</span>
                            }
                            else if (customer.MovingSaleUntil is { } ended)
                            {
                                <span class="status-badge status-ended">Ended @ended.ToString("dd-MM-yyyy")</span>
                            }
                            else if (customer.MovingSaleStatus == MovingSaleStatusDto.Rejected)
                            {
                                <span class="status-badge status-ended">Rejected</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(customers.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@code {
    private List<CustomerDto> customers = new List<CustomerDto>();

    private bool loading = false;
    private bool noAccess = false;
    private string error = "";

    private CustomerPaginationDto pagination = new CustomerPaginationDto
    {
        OrderBy = CustomerOrderBy.FullName,
        OrderType = OrderType.Ascending,
        PageNumber = 1,
        PageSize = 25,
        CustomerId = null,
        CustomerName = null,
        Email = null,
        HouseNumber = null,
        PostalCode = null,
    };

    protected override async Task OnInitializedAsync()
    {
        await Loadcustomer();
    }

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await Loadcustomer();
    }
    private async Task OrderBy(CustomerOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await Loadcustomer();
    }

    private RenderFragment SortingArrow(CustomerOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await Loadcustomer();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await Loadcustomer();
    }
    private async Task Loadcustomer()
    {
        loading = true;
        noAccess = false;
        error = "";

        (customers, error) = await customerService.GetPaginatedCustomersAsync(pagination);

        loading = false;
    }
}
