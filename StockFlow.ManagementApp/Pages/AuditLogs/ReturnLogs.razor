@page "/returnlogs"
@attribute [Authorize(Roles = Permissions.CashRegisterLogs)]
@using StockFlow.Shared.DTOs.AuditLogs.Return
@inject IReturnLogsService ReturnLogsService

<div class="tasks-header">
    <div>
        <h2>Return Logs</h2>
        <p>Every return made at the cash register.</p>
    </div>
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Receipt id</label>
                <input type="text" maxlength="@IdentifierFormats.ReceiptIdLength" @bind="pagination.ReceiptId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 9000000001" />
            </div>
            <div class="filter-group">
                <label>Employee id</label>
                <input type="text" maxlength="@FieldLimits.EmployeeId" @bind="pagination.EmployeeId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 000010" />
            </div>
            <div class="filter-group">
                <label>Customer id</label>
                <input type="text" maxlength="@IdentifierFormats.CustomerIdLength" @bind="pagination.CustomerId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 80000001" />
            </div>
        </div>
    </div>

    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(ReturnLogsOrderBy.ReceiptId)" class="sortable">
                    Receipt @SortingArrow(ReturnLogsOrderBy.ReceiptId)
                </th>
                <th>Employee</th>
                <th>Customer</th>
                <th>Products</th>
                <th @onclick="() => OrderBy(ReturnLogsOrderBy.RefundAmount)" class="sortable">
                    Refund @SortingArrow(ReturnLogsOrderBy.RefundAmount)
                </th>
                <th>Points taken back</th>
                <th @onclick="() => OrderBy(ReturnLogsOrderBy.CreatedAt)" class="sortable">
                    Returned at @SortingArrow(ReturnLogsOrderBy.CreatedAt)
                </th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (returnLogs.Count == 0)
            {
                <tr><td class="empty-state">No returns fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var log in returnLogs)
                {
                    <tr>
                        <td class="receipt-cell">@log.ReceiptId</td>
                        <td><strong>@log.EmployeeName</strong> <span class="page-note">@log.EmployeeId</span></td>
                        <td>
                            @if (log.CustomerId is null)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <strong>@log.CustomerName</strong> <span class="page-note">@log.CustomerId</span>
                            }
                        </td>
                        <td class="products-cell" @onclick="() => selectedLog = log">
                            <span class="products-count">@log.ItemsReturned @(log.ItemsReturned == 1 ? "item" : "items")</span>
                            <i class="bi bi-chevron-right"></i>
                        </td>
                        <td class="refund-cell">&euro;@log.RefundAmount.ToString("0.00")</td>
                        <td class="points-cell">
                            @if (log.PointsDeducted > 0)
                            {
                                <span class="points-used">-@log.PointsDeducted</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="date-cell">@log.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(returnLogs.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@if (selectedLog is not null)
{
    <ModalOverlay OnClose="() => selectedLog = null">
        <div class="panel-header">
            <div>
                <span class="panel-label">Receipt @selectedLog.ReceiptId</span>
                <h3>Products returned</h3>
                <p>
                    @selectedLog.EmployeeName (@selectedLog.EmployeeId) &middot;
                    @selectedLog.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                </p>
            </div>
            <button class="btn-icon" title="Close" @onclick="() => selectedLog = null">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <table class="products-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="number-cell">Amount</th>
                    <th class="number-cell">Price paid</th>
                    <th class="number-cell">Refund</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in selectedLog.Lines)
                {
                    <tr>
                        <td>
                            <strong>@line.ProductName</strong>
                            <span class="product-sub">Barcode @line.Barcode</span>
                        </td>
                        <td class="number-cell"><strong>@line.Amount&times;</strong></td>
                        <td class="number-cell">&euro;@line.PriceAtTimeOfSale.ToString("0.00")</td>
                        <td class="number-cell">&euro;@line.RefundAmount.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="panel-footer">
            @if (selectedLog.PointsDeducted > 0)
            {
                <div class="total-row">
                    <span>Points taken back</span>
                    <span>-@selectedLog.PointsDeducted</span>
                </div>
            }
            <div class="total-row total-main">
                <span>Refunded</span>
                <span>&euro;@selectedLog.RefundAmount.ToString("0.00")</span>
            </div>
        </div>
    </ModalOverlay>
}

@code {
    private List<ReturnLogDto> returnLogs = [];
    private ReturnLogDto? selectedLog;
    private bool loading;
    private string error = "";

    private readonly ReturnLogsPaginationDto pagination = new()
    {
        OrderBy = ReturnLogsOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
    };

    protected override async Task OnInitializedAsync() => await LoadLogs();

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadLogs();
    }

    private async Task OrderBy(ReturnLogsOrderBy column)
    {
        if (pagination.OrderBy == column)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = column;
            pagination.OrderType = OrderType.Descending;
        }
        pagination.PageNumber = 1;
        await LoadLogs();
    }

    private RenderFragment SortingArrow(ReturnLogsOrderBy column) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", pagination.OrderBy == column ? "sort-arrow" : "sort-arrow-inactive");
        builder.AddContent(2, pagination.OrderBy != column ? "⇅" : pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
        builder.CloseElement();
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadLogs();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        loading = true;
        error = "";
        (returnLogs, error) = await ReturnLogsService.GetPaginatedReturnLogsAsync(pagination);
        loading = false;
    }
}
