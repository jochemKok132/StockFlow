@page "/cashregisterlogs";
@attribute [Authorize(Roles = "Cashier,ServiceDesk,ShiftLeader,Manager,Admin")]
@inject ICashRegisterLogsService CashRegisterLogsService

<div class="tasks-header">
    <div>
        <h2>Cash Register Logs</h2>
        <p>All Cash Register changes.</p>
    </div>
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Customer name</label>
                <input type="text" @bind="pagination.CustomerName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Customer email</label>
                <input type="email" @bind="pagination.Email" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. john@mail.com" />
            </div>
            <div class="filter-group">
                <label>Employee name</label>
                <input type="text" @bind="pagination.EmployeeName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Employee id</label>
                <input type="text" @bind="pagination.EmployeeId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 000013" />
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th>Customer name</th>
                <th>Customer email</th>
                <th>Employee name</th>
                <th @onclick="() => OrderBy(CashRegisterLogsOrderBy.EmployeeId)" class="sortable">
                    Employee id @SortingArrow(CashRegisterLogsOrderBy.EmployeeId)
                </th>
                <th>products WIP</th>
                <th @onclick="() => OrderBy(CashRegisterLogsOrderBy.CreatedAt)" class="sortable">
                    Created at @SortingArrow(CashRegisterLogsOrderBy.CreatedAt)
                </th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these logs. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (cashRegisterLogs.Count == 0)
            {
                <tr><td class="empty-state">No logs fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var log in cashRegisterLogs)
                {
                    <tr>
                        <td><strong>@log.Customer.FullName</strong></td>
                        <td>@log.Customer.Email</td>
                        <td>@log.Employee.FullName</td>
                        <td>@log.Employee.EmployeeId</td>
                        <td>WIP</td>
                        <td class="date-cell">@log.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(cashRegisterLogs.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@code {
    private List<CashRegisterLogsDto> cashRegisterLogs = new List<CashRegisterLogsDto>();

    private bool loading = false;
    private bool noAccess = false;
    private string error = "";

    private CashRegisterLogsPaginationDto pagination = new CashRegisterLogsPaginationDto
    {
        EmployeeName = null,
        OrderBy = CashRegisterLogsOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        EmployeeId = null,
        CustomerName = null,
        Email = null,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadLogs();
    }
    private async Task OrderBy(CashRegisterLogsOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadLogs();
    }

    private RenderFragment SortingArrow(CashRegisterLogsOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadLogs();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadLogs();
    }
    private async Task LoadLogs()
    {
        loading = true;
        noAccess = false;
        error = "";

        (cashRegisterLogs, error) = await CashRegisterLogsService.GetPaginatedCashRegisterLogsAsync(pagination);

        loading = false;
    }
}
