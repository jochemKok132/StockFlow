@page "/cashregisterlogs";
@attribute [Authorize(Roles = Permissions.CashRegisterLogs)]
@using StockFlow.Shared.DTOs.CashRegister
@inject ICashRegisterLogsService CashRegisterLogsService
@inject IProductService ProductService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tasks-header">
    <div>
        <h2>Cash Register Logs</h2>
        <p>All Cash Register changes.</p>
    </div>
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Receipt id</label>
                <input type="text" maxlength="@IdentifierFormats.ReceiptIdLength" @bind="pagination.ReceiptId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 9000000001" />
            </div>
            <div class="filter-group">
                <label>Customer name</label>
                <input type="text" maxlength="@FieldLimits.Name" @bind="pagination.CustomerName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Customer email</label>
                <input type="email" maxlength="@FieldLimits.Email" @bind="pagination.Email" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. john@mail.com" />
            </div>
            <div class="filter-group">
                <label>Employee name</label>
                <input type="text" maxlength="@FieldLimits.Name" @bind="pagination.EmployeeName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. John" />
            </div>
            <div class="filter-group">
                <label>Employee id</label>
                <input type="text" maxlength="@FieldLimits.EmployeeId" @bind="pagination.EmployeeId" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 000013" />
            </div>
        </div>
    </div>

    
    @if (!string.IsNullOrEmpty(receiptError))
    {
        <div class="alert-danger">@receiptError</div>
    }
    <table class="tasks-table">
        <thead>
            <tr>
                <th>Receipt</th>
                <th>Customer name</th>
                <th>Customer email</th>
                <th>Employee name</th>
                <th @onclick="() => OrderBy(CashRegisterLogsOrderBy.EmployeeId)" class="sortable">
                    Employee id @SortingArrow(CashRegisterLogsOrderBy.EmployeeId)
                </th>
                <th>Products</th>
                <th>Points</th>
                <th @onclick="() => OrderBy(CashRegisterLogsOrderBy.CreatedAt)" class="sortable">
                    Created at @SortingArrow(CashRegisterLogsOrderBy.CreatedAt)
                </th>
                <th>Receipt PDF</th>
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these logs. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (cashRegisterLogs.Count == 0)
            {
                <tr><td class="empty-state">No logs fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var log in cashRegisterLogs)
                {
                    <tr>
                        <td class="receipt-cell">@log.ReceiptId</td>
                        <td><strong>@(log.Customer?.FullName ?? "-")</strong></td>
                        <td>@(log.Customer?.Email ?? "-")</td>
                        <td>@log.Employee?.FullName</td>
                        <td>@log.Employee?.EmployeeId</td>
                        <td class="products-cell" @onclick="() => OpenProducts(log)">
                            <span class="products-count">@log.ProductsSold.Sum(p => p.Amount) items</span>
                            @if (log.ProductsSold.Sum(p => p.ReturnedAmount) is > 0 and var returned)
                            {
                                <span class="returned-count">&middot; @returned returned</span>
                            }
                            <i class="bi bi-chevron-right"></i>
                        </td>
                        <td class="points-cell">
                            @if (log.PointsUsed == 0 && log.PointsEarned == 0)
                            {
                                <span>-</span>
                            }
                            @if (log.PointsUsed > 0)
                            {
                                <span class="points-used">-@log.PointsUsed</span>
                            }
                            @if (log.PointsEarned > 0)
                            {
                                <span class="points-earned">+@log.PointsEarned</span>
                            }
                        </td>
                        <td class="date-cell">@log.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td>
                            <button class="btn-edit" disabled="@(downloading == log.ReceiptId)" @onclick="() => DownloadReceiptAsync(log)" title="Download receipt @log.ReceiptId">
                                <i class="bi bi-file-earmark-pdf"></i> @(downloading == log.ReceiptId ? "Loading..." : "Download")
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(cashRegisterLogs.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

<SoldProductsOverlay Show="showProducts"
                     Log="selectedLog"
                     OnClose="CloseProducts"
                     OnProductClick="OpenProductDetails" />

<ProductDetails Show="showDetails"
                EditMode="false"
                ReadMode="true"
                product="selectedProduct"
                Loading="detailsLoading"
                Error="@detailsError"
                OnClose="CloseProductDetails" />

@code {
    private List<CashRegisterLogsDto> cashRegisterLogs = new List<CashRegisterLogsDto>();
    private string? downloading;
    private string receiptError = "";
    private IJSObjectReference? downloadModule;

    private async Task DownloadReceiptAsync(CashRegisterLogsDto log)
    {
        downloading = log.ReceiptId;
        receiptError = "";
        try
        {
            var (pdf, downloadError) = await CashRegisterLogsService.GetReceiptPdfAsync(log.ReceiptId);
            if (pdf is null)
            {
                receiptError = downloadError.StartsWith("Error:") ? downloadError["Error:".Length..].Trim() : downloadError;
                return;
            }

            downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await downloadModule.InvokeVoidAsync("downloadFile", $"receipt-{log.ReceiptId}.pdf", "application/pdf", pdf);
        }
        finally
        {
            downloading = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (downloadModule is not null)
            await downloadModule.DisposeAsync();
    }

    private bool loading = false;
    private bool noAccess = false;
    private string error = "";

    private CashRegisterLogsDto? selectedLog;
    private bool showProducts = false;

    private ProductDto? selectedProduct;
    private bool showDetails = false;
    private bool detailsLoading = false;
    private string detailsError = "";

    private CashRegisterLogsPaginationDto pagination = new CashRegisterLogsPaginationDto
    {
        EmployeeName = null,
        OrderBy = CashRegisterLogsOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        EmployeeId = null,
        CustomerName = null,
        Email = null,
        ReceiptId = null,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadLogs();
    }
    private async Task OrderBy(CashRegisterLogsOrderBy column)
    {
        if (pagination.OrderBy == column)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = column;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadLogs();
    }

    private RenderFragment SortingArrow(CashRegisterLogsOrderBy column) => builder =>
    {
        if (pagination.OrderBy == column)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private void OpenProducts(CashRegisterLogsDto log)
    {
        selectedLog = log;
        showProducts = true;
    }

    private void CloseProducts()
    {
        showProducts = false;
        selectedLog = null;
    }

    private async Task OpenProductDetails(RegisterItemDetailDto item)
    {
        if (item.Product is null) return;

        showProducts = false;
        showDetails = true;
        detailsLoading = true;
        detailsError = "";
        selectedProduct = null;
        await InvokeAsync(StateHasChanged);

        (selectedProduct, detailsError) = await ProductService.GetProductDetailsAsync(item.Product.Id);
        detailsLoading = false;
    }

    private void CloseProductDetails()
    {
        showDetails = false;
        detailsLoading = false;
        detailsError = "";
        selectedProduct = null;

        showProducts = selectedLog is not null;
    }

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadLogs();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadLogs();
    }
    private async Task LoadLogs()
    {
        loading = true;
        noAccess = false;
        error = "";

        (cashRegisterLogs, error) = await CashRegisterLogsService.GetPaginatedCashRegisterLogsAsync(pagination);

        loading = false;
    }
}
