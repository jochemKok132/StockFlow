@page "/productbrands";
@attribute [Authorize]
@inject IProductBrandService productBrandService
@inject AuthenticationStateProvider AuthStateProvider

<div class="tasks-header">
    <div>
        <h2>Product brand management</h2>
    </div>
    @if (canManage)
    {
        <button class="btn-save" @onclick="() => OpenCreate(new CreateProductBrandDto())">+ New brand</button>
    }
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Barcode</label>
                <input type="text" @bind="pagination.BrandName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. Flexa" />
            </div>
        </div>
    </div>


    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(ProductBrandOrderBy.BrandName)" class="sortable">
                    Brand name @SortingArrow(ProductBrandOrderBy.BrandName)
                </th>
                <th @onclick="() => OrderBy(ProductBrandOrderBy.ProductAmount)" class="sortable">
                    Product amount @SortingArrow(ProductBrandOrderBy.ProductAmount)
                </th>
                @if (canManage)
                {
                    <th>Management</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these products. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (productBrands.Count == 0)
            {
                <tr><td class="empty-state">No products fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var product in productBrands)
                {
                    <tr class="clickable-row">
                        <td><strong>@product.BrandName</strong></td>
                        <td>@product.Products.Count()</td>
                        <td>
                            <button class="btn-save" @onclick="() => OpenUpdate(product)">Edit</button>
                            <button class="btn-save" @onclick="() => DeleteItem(product)">Delete</button>
                         </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(productBrands.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

<EditItem Show="showDetails"
          EditMode="true"
          ReadMode="false"
          item="itemType"
          Loading="detailsLoading"
          Error="@detailsError"
          OnClose="CloseDetails"
          OnSave="HandleSave" />

@code {
    private List<ProductBrandDto> productBrands = new List<ProductBrandDto>();

    private bool loading = false;
    private bool detailsLoading = false;
    private string detailsError = "";
    private bool showDetails = false;
    private bool noAccess = false;
    private string error = "";

    private object? itemType;

    private bool isCreateMode;

    private bool canManage;

    private ProductBrandPaginationDto pagination = new ProductBrandPaginationDto
    {
        OrderBy = ProductBrandOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        BrandName = null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole("Manager") || authState.User.IsInRole("Admin");

        await LoadProductBrands();
    }
    private async Task DeleteItem(ProductBrandDto product)
    {
        if (!canManage) return;

        await productBrandService.SoftDeleteProductBrandAsync(product.Id);
        await ResetAndLoad();
    }
    private async Task OpenUpdate(ProductBrandDto product)
    {
        if (!canManage) return;

        isCreateMode = false;
        showDetails = true;
        detailsLoading = true;
        detailsError = "";
        await InvokeAsync(StateHasChanged);

        itemType = new UpdateProductBrandDto
        {
            Id = product.Id,
            BrandName = product.BrandName,
        };

        detailsLoading = false;
    }

    private void OpenCreate(CreateProductBrandDto item)
    {
        if (!canManage) return;

        isCreateMode = true;
        showDetails = true;
        detailsLoading = false;
        detailsError = "";
        itemType = item;
    }

    private async Task HandleSave(object? item)
    {
        if (item is null) return;

        if (!canManage)
        {
            detailsError = "You don't have permission to do this. (403 Forbidden)";
            return;
        }

        detailsLoading = true;
        detailsError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            if (isCreateMode && item is CreateProductBrandDto createDto)
            {
                await productBrandService.CreateProductBrandAsync(createDto);
            }
            else if (!isCreateMode && item is UpdateProductBrandDto updateDto)
            {
                await productBrandService.UpdateProductBrandAsync(updateDto);
            }

            showDetails = false;
            itemType = null;
            await LoadProductBrands();
        }
        catch (Exception ex)
        {
            detailsError = ex.Message;
        }
        finally
        {
            detailsLoading = false;
        }
    }

    private void CloseDetails()
    {
        showDetails = false;
        detailsError = "";
        itemType = null;
    }

    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadProductBrands();
    }
    private async Task OrderBy(ProductBrandOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadProductBrands();
    }

    private RenderFragment SortingArrow(ProductBrandOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadProductBrands();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadProductBrands();
    }
    private async Task LoadProductBrands()
    {
        loading = true;
        noAccess = false;
        error = "";

        (productBrands, error) = await productBrandService.GetPaginatedProductBrandsAsync(pagination);

        loading = false;
    }
}