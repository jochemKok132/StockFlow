@page "/shelves";
@attribute [Authorize]
@inject IShelfService shelfService
@inject AuthenticationStateProvider AuthStateProvider

<div class="tasks-header">
    <div>
        <h2>Shelf management</h2>
    </div>
    @if (canManage)
    {
        <button class="btn-save" @onclick="() => OpenCreate(new CreateShelfDto())">+ New Shelf</button>
    }
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Shelf name</label>
                <input type="text" @bind="pagination.ShelfName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. Paint" />
            </div>
            <div class="filter-group">
                <label>Location</label>
                <input type="text" @bind="pagination.Location" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 002" />
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(ShelfOrderBy.ShelfName)" class="sortable">
                    Shelf name @SortingArrow(ShelfOrderBy.ShelfName)
                </th>
                <th>Hallway</th>
                <th @onclick="() => OrderBy(ShelfOrderBy.ShelfLocation)" class="sortable">
                    Location @SortingArrow(ShelfOrderBy.ShelfLocation)
                </th>
                <th @onclick="() => OrderBy(ShelfOrderBy.ProductAmount)" class="sortable">
                    Product amount @SortingArrow(ShelfOrderBy.ProductAmount)
                </th>
                @if (canManage)
                {
                    <th>Management</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these Shelf. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (shelves.Count == 0)
            {
                <tr><td class="empty-state">No Shelf fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var shelf in shelves)
                {
                    <tr class="clickable-row" @onclick="() => OpenDetails(shelf)">
                        <td><strong>@shelf.ShelfName</strong></td>
                        <td>@shelf.ShelfHallway</td>
                        <td>@shelf.ShelfLocation</td>
                        <td>@shelf.Products.Count()</td>
                        @if (canManage)
                        {
                            <td>
                                <button class="btn-save" @onclick="() => OpenUpdate(shelf)">Edit</button>
                                <button class="btn-save" @onclick="() => DeleteItem(shelf)">Delete</button>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(shelves.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>
<EditItem Show="showChanges"
          EditMode="true"
          ReadMode="false"
          item="itemType"
          Loading="changesLoading"
          Error="@changesError"
          OnClose="CloseChanges"
          OnSave="HandleSave" />
@code {
    private List<ShelfDto> shelves = new List<ShelfDto>();

    private bool loading = false;
    private bool detailsLoading = false;
    private string detailsError = "";
    private bool showDetails = false;
    private bool noAccess = false;
    private string error = "";
    private ShelfDto? selectedshelf;
    private bool changesLoading = false;
    private string changesError = "";
    private bool showChanges = false;
    private bool canManage;

    private object? itemType;

    private bool isCreateMode;
    private ShelfPaginationDto pagination = new ShelfPaginationDto
    {
        OrderBy = ShelfOrderBy.ShelfLocation,
        OrderType = OrderType.Ascending,
        PageNumber = 1,
        PageSize = 25,
        ShelfName = null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole("Manager") || authState.User.IsInRole("Admin");

        await LoadProducts();
    }
    private async Task OpenDetails(ShelfDto dto)
    {
        showDetails = true;
        detailsLoading = true;
        detailsError = "";
        selectedshelf = null;
        await InvokeAsync(StateHasChanged);

        selectedshelf = dto;
        detailsLoading = false;
    }
    private void CloseDetails()
    {
        showDetails = false;
        detailsLoading = false;
        detailsError = "";
        selectedshelf = null;
    }
    private async Task DeleteItem(ShelfDto shelf)
    {
        if (!canManage) return;

        await shelfService.SoftDeleteShelfAsync(shelf.Id);
        await ResetAndLoad();
    }
    private async Task OpenUpdate(ShelfDto dto)
    {
        if (!canManage) return;

        isCreateMode = false;
        showChanges = true;
        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        itemType = new UpdateShelfDto
        {
            Id = dto.Id,
            ShelfLocation = dto.ShelfLocation,
            ShelfName = dto.ShelfName,
            ShelfHallway = dto.ShelfHallway,
        };


        changesLoading = false;
    }

    private void OpenCreate(CreateShelfDto item)
    {
        if (!canManage) return;

        isCreateMode = true;
        showChanges = true;
        changesLoading = false;
        changesError = "";
        itemType = item;
    }

    private async Task HandleSave(object? item)
    {
        if (item is null) return;

        if (!canManage)
        {
            changesError = "You don't have permission to do this. (403 Forbidden)";
            return;
        }

        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            if (isCreateMode && item is CreateShelfDto createDto)
            {
                await shelfService.CreateShelfAsync(createDto);
            }
            else if (!isCreateMode && item is UpdateShelfDto updateDto)
            {
                await shelfService.UpdateShelfAsync(updateDto);
            }

            showChanges = false;
            itemType = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            changesError = ex.Message;
        }
        finally
        {
            changesLoading = false;
        }
    }

    private void CloseChanges()
    {
        showChanges = false;
        changesError = "";
        itemType = null;
    }
    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadProducts();
    }
    private async Task OrderBy(ShelfOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadProducts();
    }

    private RenderFragment SortingArrow(ShelfOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadProducts();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadProducts();
    }
    private async Task LoadProducts()
    {
        loading = true;
        noAccess = false;
        error = "";

        (shelves, error) = await shelfService.GetPaginatedShelfAsync(pagination);

        loading = false;
    }
}
