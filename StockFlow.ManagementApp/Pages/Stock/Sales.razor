@page "/sales";
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject ISalesService salesService

<div class="tasks-header">
    <div>
        <h2>Sales management</h2>
    </div>
    @if (canManage)
    {
        <button class="btn-save" @onclick="() => OpenCreate(new CreateSalesDto())">+ New Sale</button>
    }
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Sale name</label>
                <input type="text" @bind="pagination.SalesName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. Summer sale" />
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(SalesOrderBy.SaleName)" class="sortable">
                    Sale name @SortingArrow(SalesOrderBy.SaleName)
                </th>
                <th @onclick="() => OrderBy(SalesOrderBy.PercentageOff)" class="sortable">
                    Percentage off @SortingArrow(SalesOrderBy.PercentageOff)
                </th>
                <th>Tags</th>
                <th @onclick="() => OrderBy(SalesOrderBy.ProductAmount)" class="sortable">
                    Product amount @SortingArrow(SalesOrderBy.ProductAmount)
                </th>
                @if (canManage)
                {
                    <th>Management</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these sales. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (sales.Count == 0)
            {
                <tr><td class="empty-state">No sales fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var sale in sales)
                {
                    <tr class="clickable-row" @onclick="() => OpenDetails(sale)">
                        <td><strong>@sale.SaleName</strong></td>
                        <td>@sale.PercentageOff</td>
                        <td>@string.Join(", ", sale.SalesTags)</td>
                        <td>@sale.Products.Count()</td>
                        <td>
                            <button class="btn-save" @onclick="() => OpenUpdate(sale)">Edit</button>
                            <button class="btn-save" @onclick="() => DeleteItem(sale)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(sales.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>
<EditItem Show="showChanges"
          EditMode="true"
          ReadMode="false"
          item="itemType"
          Loading="changesLoading"
          Error="@changesError"
          OnClose="CloseChanges"
          OnSave="HandleSave" />

@code {
    private List<SalesDto> sales = new List<SalesDto>();

    private bool loading = false;
    private bool detailsLoading = false;
    private string detailsError = "";
    private bool showDetails = false;
    private bool noAccess = false;
    private string error = "";
    private SalesDto? selectedSale; 

    private bool changesLoading = false;
    private string changesError = "";
    private bool showChanges = false;
    private bool canManage;

    private object? itemType;

    private bool isCreateMode;
    private SalesPaginationDto pagination = new SalesPaginationDto
    {
        OrderBy = SalesOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        SalesName = null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole("Manager") || authState.User.IsInRole("Admin");

        await LoadProducts();
    }
    private async Task OpenDetails(SalesDto dto)
    {
        showDetails = true;
        detailsLoading = true;
        detailsError = "";
        selectedSale = null;
        await InvokeAsync(StateHasChanged);

        selectedSale = dto;
        detailsLoading = false;
    }
    private void CloseDetails()
    {
        showDetails = false;
        detailsLoading = false;
        detailsError = "";
        selectedSale = null;
    }
    private async Task DeleteItem(SalesDto product)
    {
        if (!canManage) return;

        await salesService.SoftDeleteSalesAsync(product.Id);
        await ResetAndLoad();
    }
    private async Task OpenUpdate(SalesDto dto)
    {
        if (!canManage) return;

        isCreateMode = false;
        showChanges = true;
        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        itemType = new UpdateSalesDto
        {
            Id = dto.Id,
            Description = dto.Description,
            SalesTags = dto.SalesTags,
            SaleName = dto.SaleName,
            PercentageOff = dto.PercentageOff,
        };


        changesLoading = false;
    }

    private void OpenCreate(CreateSalesDto item)
    {
        if (!canManage) return;

        isCreateMode = true;
        showChanges = true;
        changesLoading = false;
        changesError = "";
        itemType = item;
    }

    private async Task HandleSave(object? item)
    {
        if (item is null) return;

        if (!canManage)
        {
            changesError = "You don't have permission to do this. (403 Forbidden)";
            return;
        }

        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            if (isCreateMode && item is CreateSalesDto createDto)
            {
                await salesService.CreateSalesAsync(createDto);
            }
            else if (!isCreateMode && item is UpdateSalesDto updateDto)
            {
                await salesService.UpdateSalesAsync(updateDto);
            }

            showChanges = false;
            itemType = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            changesError = ex.Message;
        }
        finally
        {
            changesLoading = false;
        }
    }

    private void CloseChanges()
    {
        showChanges = false;
        changesError = "";
        itemType = null;
    }
    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadProducts();
    }
    private async Task OrderBy(SalesOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadProducts();
    }

    private RenderFragment SortingArrow(SalesOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadProducts();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadProducts();
    }
    private async Task LoadProducts()
    {
        loading = true;
        noAccess = false;
        error = "";

        (sales, error) = await salesService.GetPaginatedSalesAsync(pagination);

        loading = false;
    }
}
