@page "/sales";
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject ISalesService salesService
@inject ILookupService LookupService
@inject ConfirmService Confirm

<div class="tasks-header">
    <div>
        <h2>Sales management</h2>
    </div>
    @if (canManage)
    {
        <button class="btn-save" @onclick="() => OpenCreate(new CreateSalesDto())"><i class="bi bi-plus-lg"></i> New sale</button>
    }
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Sale name</label>
                <input type="text" maxlength="@FieldLimits.Name" @bind="pagination.SalesName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. Summer sale" />
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select @bind="pagination.Status" @bind:after="ResetAndLoad">
                    <option value="">All, including history</option>
                    <option value="@SaleStatusDto.Active">Active</option>
                    <option value="@SaleStatusDto.Scheduled">Scheduled</option>
                    <option value="@SaleStatusDto.Ended">Ended (history)</option>
                </select>
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th @onclick="() => OrderBy(SalesOrderBy.SaleName)" class="sortable">
                    Sale name @SortingArrow(SalesOrderBy.SaleName)
                </th>
                <th @onclick="() => OrderBy(SalesOrderBy.PercentageOff)" class="sortable">
                    Deal @SortingArrow(SalesOrderBy.PercentageOff)
                </th>
                <th>Period</th>
                <th>Status</th>
                <th>Tags</th>
                <th @onclick="() => OrderBy(SalesOrderBy.ProductAmount)" class="sortable">
                    Product amount @SortingArrow(SalesOrderBy.ProductAmount)
                </th>
                <th>Items sold</th>
                @if (canManage)
                {
                    <th>Management</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these sales. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (sales.Count == 0)
            {
                <tr><td class="empty-state">No sales fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var sale in sales)
                {
                    <tr class="clickable-row" @onclick="() => OpenDetails(sale)">
                        <td><strong>@sale.SaleName</strong></td>
                        <td>@SalePricing.Describe(sale)@(sale.SaleType == SaleTypeDto.Moving ? " (moving)" : "")</td>
                        <td>@Period(sale)</td>
                        <td>@StatusBadge(sale)</td>
                        <td>@(sale.SaleType == SaleTypeDto.Moving ? "Customers who are moving" : string.Join(", ", sale.SalesTags))</td>
                        <td>@sale.Products.Count()</td>
                        <td>@sale.ItemsSold</td>
                        @if (canManage)
                        {
                            <td class="actions-cell">
                                <div class="table-actions">
                                    <button class="btn-edit" @onclick="() => OpenUpdate(sale)" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i> Edit</button>
                                    @if (sale.SaleType != SaleTypeDto.Moving)
                                    {
                                        <button class="btn-delete" disabled="@viewOnly" title="@(viewOnly ? AccessRules.ViewOnlyMessage : null)" @onclick="() => DeleteItem(sale)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i> Delete</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(sales.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>
<EditItem Show="showChanges"
          ViewOnly="viewOnly"
          EditMode="true"
          ReadMode="false"
          item="itemType"
          Lookups="lookups"
          Loading="changesLoading"
          Error="@changesError"
          OnClose="CloseChanges"
          OnSave="HandleSave" />

@code {
    private List<SalesDto> sales = new List<SalesDto>();

    private bool loading = false;
    private bool noAccess = false;
    private string error = "";
    private SalesDto? selectedSale; 

    private bool changesLoading = false;
    private string changesError = "";
    private bool showChanges = false;
    private bool canManage;
    private bool viewOnly;

    private object? itemType;

    private bool isCreateMode;
    private SalesPaginationDto pagination = new SalesPaginationDto
    {
        OrderBy = SalesOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        SalesName = null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        viewOnly = authState.User.IsInRole(AccessRules.ViewOnlyRole);
        canManage = authState.User.CanOpen(Permissions.ManageStock);

        await LoadProducts();
    }
    private async Task OpenDetails(SalesDto dto)
    {
        selectedSale = null;
        await InvokeAsync(StateHasChanged);

        selectedSale = dto;
    }
    private void CloseDetails()
    {
        selectedSale = null;
    }
    private async Task DeleteItem(SalesDto product)
    {
        if (!canManage || viewOnly) return;
        if (!await Confirm.AskAsync("Delete sale", $"Delete the sale {product.SaleName}?", "Delete", danger: true, details: ["An admin can restore it later under Deleted items."])) return;

        await salesService.SoftDeleteSalesAsync(product.Id);
        await ResetAndLoad();
    }
    private async Task OpenUpdate(SalesDto dto)
    {
        if (!canManage) return;

        isCreateMode = false;
        showChanges = true;
        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);
        await LoadLookupsAsync(dto.SaleType == SaleTypeDto.Moving);

        itemType = new UpdateSalesDto
        {
            Id = dto.Id,
            Description = dto.Description,
            SalesTags = dto.SalesTags,
            SaleName = dto.SaleName,
            SaleType = dto.SaleType,
            PercentageOff = dto.PercentageOff,
            BuyAmount = dto.BuyAmount,
            FreeAmount = dto.FreeAmount,
            BundlePrice = dto.BundlePrice,
            StartDate = dto.StartDate,
            EndDate = dto.EndDate,
        };


        changesLoading = false;
    }

    private async Task OpenCreate(CreateSalesDto item)
    {
        if (!canManage) return;

        isCreateMode = true;
        showChanges = true;
        changesLoading = true;
        changesError = "";
        itemType = item;
        await InvokeAsync(StateHasChanged);

        await LoadLookupsAsync();
        changesLoading = false;
    }

    private Dictionary<string, List<SelectOption>> lookups = new();

    private async Task LoadLookupsAsync(bool movingSale = false)
    {
        var (tags, error) = await LookupService.GetSalesTagOptionsAsync();
        List<SelectOption> types = movingSale
            ? [new SelectOption(nameof(SaleTypeDto.Moving), "Moving sale", "Only the percentage, name, description and dates can change")]
            :
            [
                new SelectOption(nameof(SaleTypeDto.Percentage), "Percentage off", "Uses Percentage off"),
                new SelectOption(nameof(SaleTypeDto.MultiBuy), "Multi-buy (1+1, 2+1, ...)", "Uses Buy amount + Free amount"),
                new SelectOption(nameof(SaleTypeDto.SecondItemHalfPrice), "Second item half price", "Every 2nd item 50% off, no other fields"),
                new SelectOption(nameof(SaleTypeDto.Bundle), "Bundle price (3 for €10, ...)", "Uses Buy amount (items in the bundle) + Bundle price"),
            ];

        lookups = new()
        {
            [nameof(CreateSalesDto.SalesTags)] = tags,
            [nameof(CreateSalesDto.SaleType)] = types,
        };

        if (!string.IsNullOrEmpty(error))
            changesError = error.StartsWith("Error:") ? error["Error:".Length..].Trim() : error;
    }

    private async Task HandleSave(object? item)
    {
        if (item is null) return;

        if (!canManage)
        {
            changesError = "You don't have permission to do this. (403 Forbidden)";
            return;
        }

        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            string result = "";
            if (isCreateMode && item is CreateSalesDto createDto)
            {
                result = await salesService.CreateSalesAsync(createDto);
            }
            else if (!isCreateMode && item is UpdateSalesDto updateDto)
            {
                result = await salesService.UpdateSalesAsync(updateDto);
            }

            if (result.StartsWith("Error:"))
            {
                changesError = result["Error:".Length..].Trim();
                return;
            }

            showChanges = false;
            itemType = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            changesError = ex.Message;
        }
        finally
        {
            changesLoading = false;
        }
    }

    private void CloseChanges()
    {
        showChanges = false;
        changesError = "";
        itemType = null;
    }
    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadProducts();
    }
    private async Task OrderBy(SalesOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadProducts();
    }

    private RenderFragment SortingArrow(SalesOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadProducts();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadProducts();
    }
    private static string Period(SalesDto sale) => (sale.StartDate, sale.EndDate) switch
    {
        (null, null) => "Always",
        ({ } start, null) => $"From {start:dd-MM-yyyy}",
        (null, { } end) => $"Until {end:dd-MM-yyyy}",
        ({ } start, { } end) => $"{start:dd-MM-yyyy} – {end:dd-MM-yyyy}",
    };

    private static RenderFragment StatusBadge(SalesDto sale) => SalePricing.Status(sale.StartDate, sale.EndDate, DateTime.Today) switch
    {
        SaleStatusDto.Scheduled => @<span class="status-badge status-update">Scheduled</span>,
        SaleStatusDto.Ended => @<span class="status-badge status-ended">Ended</span>,
        _ => @<span class="status-badge status-ok">Active</span>,
    };

    private async Task LoadProducts()
    {
        loading = true;
        noAccess = false;
        error = "";

        (sales, error) = await salesService.GetPaginatedSalesAsync(pagination);

        loading = false;
    }
}
