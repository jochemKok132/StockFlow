@page "/inventory";
@attribute [Authorize]
@inject IProductService productsService
@inject AuthenticationStateProvider AuthStateProvider

<div class="tasks-header">
    <div>
        <h2>Inventory management</h2>
    </div>
    @if (canManage)
    {
        <button class="btn-save" @onclick="() => OpenCreate(new CreateProductDto())">+ New product</button>
    }
</div>
<div class="card">
    <div class="filters-bar">
        <div class="filters">
            <div class="filter-group">
                <label>Barcode</label>
                <input type="text" @bind="pagination.Barcode" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 500146" />
            </div>
            <div class="filter-group">
                <label>Product name</label>
                <input type="text" @bind="pagination.ProductName" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. Douchemat" />
            </div>
            <div class="filter-group">
                <label>Location</label>
                <input type="text" @bind="pagination.Location" @bind:event="oninput" @bind:after="ResetAndLoad" placeholder="e.g. 002-1025" />
            </div>
        </div>
    </div>

    
    <table class="tasks-table">
        <thead>
            <tr>
                <th>Barcode</th>
                <th @onclick="() => OrderBy(ProductOrderBy.ProductName)" class="sortable">
                    Product name @SortingArrow(ProductOrderBy.ProductName)
                </th>
                <th>Location</th>
                <th>Price</th>
                <th @onclick="() => OrderBy(ProductOrderBy.Sales)" class="sortable">
                    Sales @SortingArrow(ProductOrderBy.Sales)
                </th>
                <th @onclick="() => OrderBy(ProductOrderBy.Brand)" class="sortable">
                    Brand @SortingArrow(ProductOrderBy.Brand)
                </th>
                <th @onclick="() => OrderBy(ProductOrderBy.Stock)" class="sortable">
                    Stock @SortingArrow(ProductOrderBy.Stock)
                </th>
                @if (canManage)
                {
                    <th>Management</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (loading)
            {
                <tr><td class="loading">Loading...</td></tr>
            }
            else if (noAccess)
            {
                <tr><td class="alert-danger">You don't have access to these products. (403 Forbidden)</td></tr>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <tr><td class="alert-danger">@error</td></tr>
            }
            else if (products.Count == 0)
            {
                <tr><td class="empty-state">No products fitting the criteria found.</td></tr>
            }
            else
            {
                @foreach (var product in products)
                {
                    <tr class="clickable-row" @onclick="() => OpenDetails(product)">
                        <td><strong>@product.Barcode</strong></td>
                        <td>@product.ProductName</td>
                        <td>@product.Location</td>
                        <td>@product.Price</td>
                        <td>@if (product.Sale)
                            {
                                <i class="bi bi-tag-fill"></i>
                            }
                        </td>
                        <td>@product.BrandName</td>
                        <td>@product.Stock</td>
                        <td>
                            <button class="btn-save" @onclick="() => OpenUpdate(product)" @onclick:stopPropagation="true">Edit</button>
                            <button class="btn-save" @onclick="() => DeleteItem(product)" @onclick:stopPropagation="true">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(pagination.PageNumber <= 1)">&#8592; Previous</button>
        <span>Page <strong>@pagination.PageNumber</strong></span>
        <button @onclick="NextPage" disabled="@(products.Count < pagination.PageSize)">Next &#8594;</button>
        <div class="page-size">
            <label>Per page:</label>
            <select @bind="pagination.PageSize" @bind:after="ResetAndLoad">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

<ProductDetails Show="showDetails"
       EditMode="false"
       ReadMode="true"
       product="selectedProduct"
       Loading="detailsLoading"
       Error="@detailsError"
       OnClose="CloseDetails"/>

<EditItem Show="showChanges"
          EditMode="true"
          ReadMode="false"
          item="itemType"
          Loading="changesLoading"
          Error="@changesError"
          OnClose="CloseChanges"
          OnSave="HandleSave" />

@code {
    private List<ProductBulkViewDto> products = new List<ProductBulkViewDto>();

    private bool loading = false;
    private bool detailsLoading = false;
    private string detailsError = "";
    private bool showDetails = false;
    private bool noAccess = false;
    private string error = "";
    private ProductDto? selectedProduct; 

    private bool changesLoading = false;
    private string changesError = "";
    private bool showChanges = false;

    private object? itemType;

    private bool isCreateMode;

    private bool canManage;
    private ProductPaginationDto pagination = new ProductPaginationDto
    {
        OrderBy = ProductOrderBy.CreatedAt,
        OrderType = OrderType.Descending,
        PageNumber = 1,
        PageSize = 25,
        ProductName = null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole("Manager") || authState.User.IsInRole("Admin");

        await LoadProducts();
    }
    private async Task OpenDetails(ProductBulkViewDto dto)
    {
        showDetails = true;
        detailsLoading = true;
        detailsError = "";
        selectedProduct = null;
        await InvokeAsync(StateHasChanged);

        (selectedProduct, detailsError) = await productsService.GetProductDetailsAsync(dto.Id);
        detailsLoading = false;
    }
    private void CloseDetails()
    {
        showDetails = false;
        detailsLoading = false;
        detailsError = "";
        selectedProduct = null;
    }
    private async Task DeleteItem(ProductBulkViewDto product)
    {
        if (!canManage) return;

        await productsService.SoftDeleteProductAsync(product.Id);
        await ResetAndLoad();
    }
    private async Task OpenUpdate(ProductBulkViewDto dto)
    {
        if (!canManage) return;

        isCreateMode = false;
        showChanges = true;
        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);
        (var product, detailsError) = await productsService.GetProductDetailsAsync(dto.Id);

        itemType = new UpdateProductDto
        {
            Id = product.Id,
            Description = product.Description,
            ProductName = product.ProductName,
            BrandId = product.BrandId,
            Location = product.Location,
            Price = product.Price,
            ProductImage = product.ProductImage,
            Sales = product.Sales,
            SalesTags = product.SalesTags,
            ShelfId = product.ShelfId,
            Stock = product.Stock,
        };

        changesLoading = false;
    }

    private void OpenCreate(CreateProductDto item)
    {
        if (!canManage) return;

        isCreateMode = true;
        showChanges = true;
        changesLoading = false;
        changesError = "";
        itemType = item;
    }

    private async Task HandleSave(object? item)
    {
        if (item is null) return;

        if (!canManage)
        {
            changesError = "You don't have permission to do this. (403 Forbidden)";
            return;
        }

        changesLoading = true;
        changesError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            if (isCreateMode && item is CreateProductDto createDto)
            {
                await productsService.CreateProductAsync(createDto);
            }
            else if (!isCreateMode && item is UpdateProductDto updateDto)
            {
                await productsService.UpdateProductAsync(updateDto);
            }

            showChanges = false;
            itemType = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            changesError = ex.Message;
        }
        finally
        {
            changesLoading = false;
        }
    }

    private void CloseChanges()
    {
        showChanges = false;
        changesError = "";
        itemType = null;
    }
    private async Task ResetAndLoad()
    {
        pagination.PageNumber = 1;
        await LoadProducts();
    }
    private async Task OrderBy(ProductOrderBy kolom)
    {
        if (pagination.OrderBy == kolom)
            pagination.OrderType = pagination.OrderType == OrderType.Ascending ? OrderType.Descending : OrderType.Ascending;
        else
        {
            pagination.OrderBy = kolom;
            pagination.OrderType = OrderType.Ascending;
        }
        pagination.PageNumber = 1;
        await LoadProducts();
    }

    private RenderFragment SortingArrow(ProductOrderBy kolom) => builder =>
    {
        if (pagination.OrderBy == kolom)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow");
            builder.AddContent(2, pagination.OrderType == OrderType.Ascending ? "▲" : "▼");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sort-arrow-inactive");
            builder.AddContent(2, "⇅");
            builder.CloseElement();
        }
    };

    private async Task NextPage()
    {
        pagination.PageNumber++;
        await LoadProducts();
    }

    private async Task PrevPage()
    {
        if (pagination.PageNumber > 1)
            pagination.PageNumber--;
        await LoadProducts();
    }
    private async Task LoadProducts()
    {
        loading = true;
        noAccess = false;
        error = "";

        (products, error) = await productsService.GetPaginatedProductsAsync(pagination);

        loading = false;
    }
}
