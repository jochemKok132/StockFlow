@using System.Collections
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms

@if (Show)
{
    <ModalOverlay OnClose="OnClose">
        <div class="panel-header">
            <div>
                <span class="panel-label">@(ReadMode ? "Details" : "Edit")</span>
                <h3>@Title</h3>
            </div>
            <button class="btn-icon" title="Close" @onclick="OnClose">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (Loading)
        {
            <div class="loading">Loading details...</div>
        }
        else if (item is null)
        {
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert-danger">@Error</div>
            }
            else
            {
                <div class="empty-state">No details available.</div>
            }
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert-danger">@Error</div>
            }

            <div class="form-grid">
                @foreach (var prop in EditableProperties.Where(p => !IsHidden(p)))
                {
                    <div class="form-row">
                        <label class="form-label" for="@prop.Name">@DisplayName(prop)</label>

                        @if (prop.PropertyType == typeof(byte[]))
                        {
                            var imgUrl = GetImageDataUrl(prop);
                            <div class="image-field">
                                @if (imgUrl is not null)
                                {
                                    <img src="@imgUrl" alt="@prop.Name" class="image-preview" />
                                }
                                @if (!ReadMode)
                                {
                                    <InputFile OnChange="e => HandleFileSelected(e, prop)" accept="@ImageFormats.Accept" class="form-input-file" />
                                }
                            </div>
                        }
                        else if (IsStringCollection(prop.PropertyType))
                        {
                            <SearchableMultiSelect Id="@prop.Name"
                                                   Options="OptionsFor(prop)"
                                                   Values="GetValues(prop)"
                                                   ValuesChanged="values => SetValues(prop, values)"
                                                   AllowCustom="true"
                                                   MaxLength="FieldLimits.Tag"
                                                   Disabled="ReadMode"
                                                   Placeholder="@($"Search or add {SplitPascalCase(prop.Name).ToLowerInvariant()}...")" />
                        }
                        else if (HasLookup(prop))
                        {
                            <SearchableSelect Id="@prop.Name"
                                              Options="OptionsFor(prop)"
                                              Value="@GetSelectValue(prop)"
                                              ValueChanged="value => SetValueFromString(prop, value)"
                                              Disabled="ReadMode"
                                              Placeholder="@($"Search {LookupName(prop)}...")" />
                        }
                        else if (GetUnderlyingType(prop.PropertyType) == typeof(bool))
                        {
                            <input id="@prop.Name" type="checkbox" class="form-checkbox"
                                   checked="@((bool)(prop.GetValue(item) ?? false))"
                                   disabled="@ReadMode"
                                   @onchange="e => SetValueFromString(prop, ((e.Value as bool?) ?? false).ToString())" />
                        }
                        else
                        {
                            var maxLength = MaxLengthOf(prop);
                            <input id="@prop.Name" type="@(prop.Name.Contains("Password") ? "password" : GetInputType(prop.PropertyType))" class="form-input"
                                   autocomplete="@(prop.Name.Contains("Password") ? "new-password" : null)"
                                   placeholder="@(prop.Name == "NewPassword" ? "Leave empty to keep the current password" : null)"
                                   maxlength="@maxLength"
                                   value="@GetValueAsString(prop)"
                                   readonly="@ReadMode"
                                   @oninput="e => OnTyping(prop, e)"
                                   @onchange="e => SetValueFromString(prop, e.Value?.ToString() ?? string.Empty)" />
                            @if (maxLength is int max && !ReadMode)
                            {
                                var length = LengthOf(prop);
                                <span class="char-count @(length >= max ? "is-full" : length >= max * 0.9 ? "is-near" : "")">@length / @max</span>
                            }
                        }
                    </div>
                }
            </div>

            @if (EditMode)
            {
                <div class="form-actions">
                    @if (IsUpdate && !HasChanges && !editing)
                    {
                        <span class="no-changes">No changes to save.</span>
                    }
                    <button type="button" class="btn-cancel" @onclick="OnClose">Cancel</button>
                    <button type="button" class="btn-save" disabled="@(IsUpdate && !HasChanges && !editing)" @onclick="HandleSave"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            }
        }
    </ModalOverlay>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public bool ReadMode { get; set; }
    [Parameter] public object? item { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Error { get; set; } = "";
    [Parameter] public Dictionary<string, List<SelectOption>>? Lookups { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<object?> OnSave { get; set; }

    private object? snapshotItem;
    private string? snapshot;
    private bool editing;
    private readonly Dictionary<string, int> typedLengths = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(item, snapshotItem)) return;

        snapshotItem = item;
        editing = false;
        typedLengths.Clear();
        snapshot = item is null ? null : CreateSnapshot();
    }

    private bool IsUpdate =>
        item?.GetType().GetProperty("Id")?.GetValue(item) is Guid id && id != Guid.Empty;

    private bool HasChanges => snapshot is null || CreateSnapshot() != snapshot;

    private string CreateSnapshot()
    {
        var values = new SortedDictionary<string, object?>();
        foreach (var prop in EditableProperties)
            values[prop.Name] = Normalize(prop.GetValue(item));

        return System.Text.Json.JsonSerializer.Serialize(values);
    }

    private static object? Normalize(object? value) => value switch
    {
        null => "",
        string text => text.Trim(),
        byte[] bytes => Convert.ToBase64String(bytes),
        IEnumerable<string> list => list
            .Select(v => v.Trim())
            .Where(v => v.Length > 0)
            .Order(StringComparer.OrdinalIgnoreCase)
            .ToArray(),
        DateTime date => date.ToString("O"),
        decimal amount => amount.ToString("0.############################", CultureInfo.InvariantCulture),
        IFormattable number => number.ToString(null, CultureInfo.InvariantCulture),
        _ => value.ToString(),
    };

    private IEnumerable<PropertyInfo> EditableProperties =>
        item?.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.CanWrite && IsSupported(p.PropertyType))
        ?? Enumerable.Empty<PropertyInfo>();

    private static bool IsSupported(Type type)
    {
        var t = GetUnderlyingType(type);

        if (t.IsPrimitive || t.IsEnum) return true;
        if (t == typeof(string) || t == typeof(decimal) || t == typeof(Guid) || t == typeof(DateTime)) return true;
        if (type == typeof(byte[])) return true;
        if (IsStringCollection(type)) return true;

        return false;
    }

    private string Title
    {
        get
        {
            var name = item?.GetType().Name ?? "Item";
            if (name.EndsWith("Dto")) name = name[..^3];
            var words = SplitPascalCase(name);
            return words.Length > 1 ? words[0] + words[1..].ToLowerInvariant() : words;
        }
    }

    private bool HasLookup(PropertyInfo prop) =>
        GetUnderlyingType(prop.PropertyType).IsEnum || (Lookups?.ContainsKey(prop.Name) ?? false);

    private List<SelectOption> OptionsFor(PropertyInfo prop)
    {
        if (Lookups is not null && Lookups.TryGetValue(prop.Name, out var options))
            return options;

        var type = GetUnderlyingType(prop.PropertyType);
        if (type.IsEnum)
            return Enum.GetNames(type).Select(name => new SelectOption(name, SplitPascalCase(name))).ToList();

        return [];
    }

    private string? GetSelectValue(PropertyInfo prop)
    {
        var value = prop.GetValue(item);
        if (value is null || (value is Guid guid && guid == Guid.Empty)) return null;
        return value.ToString();
    }

    private List<string> GetValues(PropertyInfo prop) =>
        (prop.GetValue(item) as IEnumerable<string>)?.ToList() ?? [];

    private void SetValues(PropertyInfo prop, List<string> values) =>
        prop.SetValue(item, values.ToArray());

    private static string DisplayName(PropertyInfo prop)
    {
        var name = prop.Name.EndsWith("Id") && prop.PropertyType == typeof(Guid) ? prop.Name[..^2] : prop.Name;
        return SplitPascalCase(name);
    }

    private static string LookupName(PropertyInfo prop) => DisplayName(prop).ToLowerInvariant();

    private bool IsHidden(PropertyInfo prop) =>
        prop.Name == "Id" || prop.Name == "HashedPassword" ||
        (GetUnderlyingType(prop.PropertyType) == typeof(Guid) && !HasLookup(prop));

    private static int? MaxLengthOf(PropertyInfo prop) =>
        prop.GetCustomAttribute<MaxLengthAttribute>()?.Length ??
        prop.GetCustomAttribute<StringLengthAttribute>()?.MaximumLength;

    private int LengthOf(PropertyInfo prop) =>
        typedLengths.TryGetValue(prop.Name, out var length) ? length : GetValueAsString(prop).Length;

    private void OnTyping(PropertyInfo prop, ChangeEventArgs e)
    {
        editing = true;
        typedLengths[prop.Name] = e.Value?.ToString()?.Length ?? 0;
    }

    private static string SplitPascalCase(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value, "(?<=[a-z])(?=[A-Z])", " ");

    private static Type GetUnderlyingType(Type type) => Nullable.GetUnderlyingType(type) ?? type;

    private static bool IsStringCollection(Type type) =>
        type != typeof(string) && typeof(IEnumerable<string>).IsAssignableFrom(type);

    private static string GetInputType(Type type)
    {
        var t = GetUnderlyingType(type);

        if (t == typeof(int) || t == typeof(long) || t == typeof(short) ||
            t == typeof(decimal) || t == typeof(double) || t == typeof(float))
            return "number";

        if (t == typeof(DateTime))
            return "date";

        return "text";
    }

    private string GetValueAsString(PropertyInfo prop)
    {
        var value = prop.GetValue(item);
        if (value is null) return string.Empty;

        if (value is DateTime dt)
            return dt.ToString("yyyy-MM-dd");

        if (value is IEnumerable enumerable && value is not string)
            return string.Join(", ", enumerable.Cast<object>());

        return value.ToString() ?? string.Empty;
    }

    private void SetValueFromString(PropertyInfo prop, string value)
    {
        var underlyingType = GetUnderlyingType(prop.PropertyType);

        try
        {
            object? converted;

            if (underlyingType == typeof(string))
            {
                converted = value;
            }
            else if (underlyingType.IsEnum)
            {
                converted = Enum.Parse(underlyingType, value, ignoreCase: true);
            }
            else if (underlyingType == typeof(Guid))
            {
                converted = Guid.Parse(value);
            }
            else if (underlyingType == typeof(bool))
            {
                converted = bool.Parse(value);
            }
            else if (underlyingType == typeof(DateTime))
            {
                converted = DateTime.Parse(value, CultureInfo.InvariantCulture);
            }
            else if (IsStringCollection(prop.PropertyType))
            {
                converted = value
                    .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            }
            else
            {
                converted = Convert.ChangeType(value, underlyingType, CultureInfo.InvariantCulture);
            }

            prop.SetValue(item, converted);
        }
        catch
        {
        }
        finally
        {
            editing = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e, PropertyInfo prop)
    {
        var file = e.File;
        if (file is null) return;

        if (!ImageFormats.IsAllowedContentType(file.ContentType))
        {
            Error = $"'{file.Name}' is not an image. Choose a PNG, JPEG, GIF or WebP file.";
            return;
        }

        if (file.Size > FieldLimits.MaxImageBytes)
        {
            Error = $"'{file.Name}' exceeds the {FieldLimits.MaxImageBytes / (1024 * 1024)} MB limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(FieldLimits.MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();
            if (!ImageFormats.IsImage(bytes))
            {
                Error = $"'{file.Name}' is not a valid image. Choose a PNG, JPEG, GIF or WebP file.";
                return;
            }

            Error = "";
            prop.SetValue(item, bytes);
            StateHasChanged();
        }
        catch (IOException)
        {
            Error = $"'{file.Name}' exceeds the {FieldLimits.MaxImageBytes / (1024 * 1024)} MB limit.";
        }
    }

    private string? GetImageDataUrl(PropertyInfo prop)
    {
        var value = prop.GetValue(item) as byte[];
        if (value is null || value.Length == 0) return null;

        var contentType = ImageFormats.DetectContentType(value) ?? "image/png";
        return $"data:{contentType};base64,{Convert.ToBase64String(value)}";
    }

    private async Task HandleSave()
    {
        editing = false;
        if (IsUpdate && !HasChanges) return;

        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync(item);
        }
    }
}